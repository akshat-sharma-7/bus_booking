<% content_for :title, "Search Trips — Bus Booking" %>

<div class="flex flex-col lg:flex-row gap-8">
  <aside class="lg:w-72 shrink-0">
    <%= form_with url: trips_path, method: :get, class: "bg-white rounded-lg border border-gray-200 p-5 space-y-4",
          data: { controller: "date-quick-pick" } do |form| %>
      <%# Native <input list> + <datalist> — type freely or pick from the
          suggestions, no JS framework needed. Cities come from @cities (the
          same real-trip-data-backed list the old <select> used); a typed
          value that matches nothing just yields zero search results (the
          route scope is a plain WHERE, never raises). %>
      <datalist id="city_options">
        <% @cities.each { |city| %><option value="<%= city %>"><% } %>
      </datalist>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">From</label>
        <%= form.text_field :from_city, value: @search_params[:from_city], list: "city_options",
              placeholder: "Type or select a city", autocomplete: "off",
              class: "block w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-blue-600" %>
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">To</label>
        <%= form.text_field :to_city, value: @search_params[:to_city], list: "city_options",
              placeholder: "Type or select a city", autocomplete: "off",
              class: "block w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-blue-600" %>
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Travel date</label>
        <div class="flex gap-1 mb-2">
          <button type="button" data-action="date-quick-pick#today"
                  class="flex-1 rounded-md border border-gray-300 px-2 py-1.5 text-xs font-medium <%= 'bg-blue-600 text-white border-blue-600' if @search_params[:travel_date] == Date.current.iso8601 %> hover:border-blue-400">Today</button>
          <button type="button" data-action="date-quick-pick#tomorrow"
                  class="flex-1 rounded-md border border-gray-300 px-2 py-1.5 text-xs font-medium <%= 'bg-blue-600 text-white border-blue-600' if @search_params[:travel_date] == Date.tomorrow.iso8601 %> hover:border-blue-400">Tomorrow</button>
          <button type="button" data-action="date-quick-pick#selectDate"
                  class="flex-1 rounded-md border border-gray-300 px-2 py-1.5 text-xs font-medium text-gray-700 hover:border-blue-400">Select Date</button>
        </div>
        <%= form.date_field :travel_date, value: @search_params[:travel_date], data: { date_quick_pick_target: "input" },
              class: "block w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-blue-600" %>
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Min. operator rating</label>
        <%= form.select :min_rating, [["Any", nil], ["3.0+", 3.0], ["3.5+", 3.5], ["4.0+", 4.0], ["4.5+", 4.5]],
              { selected: @search_params[:min_rating] }, class: "block w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-blue-600" %>
      </div>

      <div class="flex gap-2">
        <div class="w-1/2">
          <label class="block text-sm font-medium text-gray-700 mb-1">Min price</label>
          <%= form.number_field :price_min, value: @search_params[:price_min], min: 0,
                class: "block w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-blue-600" %>
        </div>
        <div class="w-1/2">
          <label class="block text-sm font-medium text-gray-700 mb-1">Max price</label>
          <%= form.number_field :price_max, value: @search_params[:price_max], min: 0,
                class: "block w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-blue-600" %>
        </div>
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Bus type</label>
        <%= form.select :bus_type, [["Any", nil]] + @bus_types.map { |t| [t.titleize, t] },
              { selected: @search_params[:bus_type] }, class: "block w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-blue-600" %>
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Amenities</label>
        <div class="space-y-1">
          <% @amenity_options.each do |amenity| %>
            <label class="flex items-center gap-2 text-sm text-gray-700">
              <%= check_box_tag "amenities[]", amenity, Array(@search_params[:amenities]).include?(amenity), id: "amenity_#{amenity}", class: "rounded border-gray-300" %>
              <%= amenity.titleize %>
            </label>
          <% end %>
        </div>
      </div>

      <%= form.submit "Search", class: "w-full rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium cursor-pointer" %>
      <%= link_to "Clear filters", trips_path, class: "block text-center text-sm text-gray-500 hover:text-blue-600" %>
    <% end %>
  </aside>

  <div class="flex-1">
    <h1 class="font-bold text-2xl mb-1">Search Trips</h1>
    <p class="text-gray-500 text-sm mb-6"><%= pluralize(@results.size, "trip") %> found</p>

    <% if @results.empty? %>
      <div class="bg-white rounded-lg border border-gray-200 p-8 text-center text-gray-500">
        No trips match your search. Try widening your filters.
      </div>
    <% else %>
      <div class="space-y-4">
        <% @results.each do |result| %>
          <%= link_to trip_path(result.trip), class: "block bg-white rounded-lg border border-gray-200 p-5 hover:border-blue-400 hover:shadow-sm transition" do %>
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
              <div class="flex-1">
                <div class="flex items-center gap-3">
                  <span class="font-semibold text-lg"><%= result.trip.operator.name %></span>
                  <span class="inline-flex items-center gap-1 text-sm text-amber-600 font-medium">
                    &#9733; <%= number_with_precision(result.trip.operator.rating, precision: 1) %>
                  </span>
                </div>

                <div class="mt-2 flex items-center gap-3 text-sm text-gray-600">
                  <span><%= result.trip.from_city %> &rarr; <%= result.trip.to_city %></span>
                  <span class="text-gray-300">|</span>
                  <span><%= result.trip.departure_time.strftime("%d %b, %H:%M") %> &ndash; <%= result.trip.arrival_time.strftime("%H:%M") %></span>
                </div>

                <div class="mt-2 flex flex-wrap items-center gap-2 text-xs">
                  <span class="px-2 py-0.5 rounded-full bg-gray-100 text-gray-700"><%= result.trip.bus_type.titleize %></span>
                  <% result.trip.amenities.each do |amenity| %>
                    <span class="px-2 py-0.5 rounded-full bg-blue-50 text-blue-700"><%= amenity.titleize %></span>
                  <% end %>
                </div>
              </div>

              <div class="text-right shrink-0">
                <div class="text-2xl font-bold text-gray-900">&#8377;<%= number_with_precision(result.trip.price, precision: 0) %></div>
                <div class="text-sm <%= result.available_seats_count > 0 ? 'text-green-600' : 'text-red-500' %>">
                  <%= result.available_seats_count > 0 ? "#{result.available_seats_count} seats left" : "Sold out" %>
                </div>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
