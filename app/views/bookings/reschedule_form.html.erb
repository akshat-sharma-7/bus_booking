<% content_for :title, "Reschedule Booking — Bus Booking" %>

<div class="max-w-lg mx-auto">
  <%= link_to "&larr; Back to booking".html_safe, booking_path(@booking), class: "text-sm text-gray-500 hover:text-blue-600" %>

  <div class="bg-white rounded-lg border border-gray-200 p-6 mt-4">
    <h1 class="font-bold text-2xl mb-1">Reschedule Booking</h1>
    <p class="text-sm text-gray-500 mb-4">
      PNR <%= @booking.pnr %> &middot; <%= @booking.trip.from_city %> &rarr; <%= @booking.trip.to_city %> &middot;
      currently <%= @booking.trip.travel_date.strftime("%d %b %Y") %>, <%= @booking.trip.departure_time.strftime("%H:%M") %>
      &middot; <%= pluralize(@booking.booking_seats.size, "seat") %>
    </p>

    <% if @target_trips.empty? %>
      <div class="text-center py-6 text-gray-500 text-sm">
        No other <%= @booking.trip.operator.name %> trips on this route are scheduled right now.
      </div>
    <% else %>
      <%= form_with url: reschedule_booking_path(@booking), method: :post, class: "space-y-2" do %>
        <% @target_trips.each do |trip| %>
          <label class="flex items-center justify-between gap-3 border border-gray-200 rounded-md px-4 py-3 cursor-pointer hover:border-blue-400 has-[:checked]:border-blue-600 has-[:checked]:bg-blue-50">
            <span class="flex items-center gap-3">
              <input type="radio" name="trip_id" value="<%= trip.id %>" required class="text-blue-600">
              <span>
                <span class="block text-sm font-medium"><%= trip.travel_date.strftime("%d %b %Y") %>, <%= trip.departure_time.strftime("%H:%M") %></span>
                <span class="block text-xs text-gray-500"><%= trip.bus_type.titleize %> &middot; <%= trip.available_seats_count %> seats left</span>
              </span>
            </span>
            <span class="text-sm font-semibold">&#8377;<%= number_with_precision(trip.price, precision: 0) %></span>
          </label>
        <% end %>

        <%= submit_tag "Confirm Reschedule", class: "w-full mt-4 rounded-md px-4 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium cursor-pointer" %>
      <% end %>
    <% end %>
  </div>
</div>
