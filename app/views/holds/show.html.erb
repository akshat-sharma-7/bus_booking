<% content_for :title, "Confirm Your Seats — Bus Booking" %>

<div class="max-w-lg mx-auto">
  <div class="bg-white rounded-lg border border-gray-200 p-6">
    <h1 class="font-bold text-2xl mb-1"><%= @trip.operator.name %></h1>
    <p class="text-sm text-gray-500 mb-4">
      <%= @trip.from_city %> &rarr; <%= @trip.to_city %> &middot;
      <%= @trip.travel_date.strftime("%d %b %Y") %>, <%= @trip.departure_time.strftime("%H:%M") %>
    </p>

    <div class="border-t border-b border-gray-100 py-4 my-4 space-y-2">
      <div class="flex justify-between text-sm">
        <span class="text-gray-500">Seats</span>
        <span class="font-medium"><%= @holds.map { |h| h.seat.seat_number }.join(", ") %></span>
      </div>
      <div class="flex justify-between text-sm">
        <span class="text-gray-500">Price per seat</span>
        <span class="font-medium">&#8377;<%= number_with_precision(@trip.price, precision: 0) %></span>
      </div>
      <div class="flex justify-between text-base font-bold">
        <span>Total</span>
        <span>&#8377;<%= number_with_precision(@trip.price * @holds.size, precision: 0) %></span>
      </div>
    </div>

    <% if @expired %>
      <div class="text-center py-4">
        <p class="text-red-600 font-medium mb-3">This hold has expired.</p>
        <p class="text-sm text-gray-500 mb-4">Your seats were released. Please select seats again.</p>
        <%= link_to "Select seats again", trip_path(@trip), class: "inline-block rounded-md px-4 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium" %>
      </div>
    <% else %>
      <div data-controller="hold-countdown" data-hold-countdown-expires-at-value="<%= @expires_at.iso8601 %>"
           data-hold-countdown-reload-url-value="<%= trip_hold_path(@trip, @hold_group_id) %>">
        <div class="text-center mb-4">
          <p class="text-sm text-gray-500">Hold expires in</p>
          <p data-hold-countdown-target="display" class="text-3xl font-bold text-gray-900 tabular-nums">05:00</p>
        </div>

        <p data-hold-countdown-target="expiredMessage" class="hidden text-center text-red-600 text-sm mb-4">
          Your hold just expired. Refreshing&hellip;
        </p>

        <%= form_with url: bookings_path, method: :post, class: "space-y-2" do %>
          <%= hidden_field_tag :hold_group_id, @hold_group_id %>
          <%= submit_tag "Continue to Booking", data: { hold_countdown_target: "confirmButton" },
                class: "w-full rounded-md px-4 py-2.5 bg-green-600 hover:bg-green-500 disabled:bg-gray-300 disabled:cursor-not-allowed text-white font-medium cursor-pointer" %>
        <% end %>

        <%= button_to "Cancel Hold", trip_hold_path(@trip, @hold_group_id), method: :delete,
              form: { data: { turbo_confirm: "Cancel this hold? Your selected seats will be released immediately." } },
              class: "w-full mt-2 rounded-md px-4 py-2.5 bg-white hover:bg-gray-50 text-gray-700 border border-gray-300 font-medium cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>
